{
  "name": "cisus-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Cisus - Constitution 1.1",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/security/*.spec.js lib/sales/*.spec.js lib/media/*.spec.js",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  }
}
